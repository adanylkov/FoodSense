@using FoodSense.Common.Models

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark">Manage Pantry - @Product.ProductName</h5>
                    <p class="text-secondary extra-small mb-0">Barcode: @Product.Barcode</p>
                </div>
                <button type="button" class="btn-close" @onclick="OnClose" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 bg-body-tertiary">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold extra-small text-uppercase text-secondary mb-2">
                            @(EditingPantryItemId.HasValue ? "Edit Pantry Item" : "Add New Pantry Instance")
                        </h6>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label extra-small text-secondary mb-1">Quantity</label>
                                <input type="number" min="1" class="form-control form-control-sm" 
                                       value="@Quantity" 
                                       @onchange="OnQuantityChanged" />
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex gap-1">
                                    <button type="button" 
                                            class="btn btn-primary btn-sm w-100 fw-semibold extra-small" 
                                            disabled="@IsSaving"
                                            @onclick="OnSave">
                                        @if (IsSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <span>@(EditingPantryItemId.HasValue ? "Update" : "Add")</span>
                                        }
                                    </button>
                                    @if (EditingPantryItemId.HasValue)
                                    {
                                        <button type="button" class="btn btn-light border btn-sm extra-small" @onclick="OnResetForm">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold extra-small text-uppercase text-secondary mb-2 px-1">Registered Stock Entries</h6>
                @if (Product.PantryItems != null && Product.PantryItems.Any())
                {
                    <div class="list-group shadow-sm rounded-3 border-0 overflow-hidden">
                        @foreach (var item in Product.PantryItems)
                        {
                            <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-bottom last-child-border-0">
                                <div>
                                    <div class="fw-bold text-dark">Quantity: @item.Quantity</div>
                                    <div class="text-secondary extra-small">
                                        Added: @item.AddedAt.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-light border btn-sm extra-small fw-semibold" @onclick="() => OnStartEditingItem.InvokeAsync(item)">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm extra-small fw-semibold" @onclick="() => OnDeleteItem.InvokeAsync(item.Id)">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4 bg-white rounded-3 border">
                        <p class="text-secondary extra-small mb-0 fst-italic">No active pantry items recorded for this product.</p>
                    </div>
                }
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-secondary rounded-3 px-4 fw-semibold" @onclick="OnClose">Close</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ProductDto Product { get; set; }
    [Parameter] public int? EditingPantryItemId { get; set; }
    [Parameter] public decimal Quantity { get; set; } = 1;
    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public EventCallback<ChangeEventArgs> OnQuantityChanged { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnResetForm { get; set; }
    [Parameter] public EventCallback<PantryItemDto> OnStartEditingItem { get; set; }
    [Parameter] public EventCallback<int> OnDeleteItem { get; set; }
}