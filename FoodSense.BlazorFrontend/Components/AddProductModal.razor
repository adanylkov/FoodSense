@using FoodSense.BlazorFrontend.ViewModels
@using FoodSense.Common.Models
@inherits ViewModelComponent<AddProductModalViewModel>

@if (VM.IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Dodaj produkty do: @VM.CurrentMealType</h5>
                    <button type="button" class="btn-close" @onclick="VM.Close"></button>
                </div>
                <div class="modal-body py-4">
                    
                    <div class="row g-4">
                        <!-- LEWA KOLUMNA: Wyszukiwanie -->
                        <div class="col-md-5 border-end">
                            <h6 class="fw-bold mb-3">Wyszukaj produkty</h6>

                            <!-- Skanowanie kodu kreskowego -->
                            <div class="mb-3">
                                <label class="form-label text-secondary small fw-semibold">Kod kreskowy</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Wpisz lub zeskanuj..." @value="VM.BarcodeQuery" @onchange="VM.SearchByBarcodeAsync" />
                                    <button class="btn btn-outline-primary" type="button" @onclick="VM.SearchByBarcodeAsync">Szukaj</button>
                                </div>
                            </div>

                            <div class="text-center text-muted my-2">- lub -</div>

                            <!-- Wyszukiwanie po nazwie -->
                            <div class="mb-3">
                                <label class="form-label text-secondary small fw-semibold">Nazwa produktu</label>
                                <input type="text" class="form-control" placeholder="Zacznij pisać nazwę..." 
                                       @bind="VM.SearchQuery" 
                                       @bind:event="oninput" 
                                       @bind:after="VM.SearchProductsAsync" />
                            </div>

                            <!-- Lista wyników wyszukiwania -->
                            @if (VM.SearchResults.Any())
                            {
                                <div class="list-group shadow-sm" style="max-height: 250px; overflow-y: auto;">
                                    @foreach (var prod in VM.SearchResults)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @onclick="() => VM.AddProduct(prod)">
                                            <div>
                                                <span class="fw-semibold d-block">@prod.ProductName</span>
                                                <small class="text-muted">@prod.Nutrients?.EnergyKcal kcal / 100g</small>
                                            </div>
                                            <span class="badge bg-primary rounded-pill">+ Dodaj</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <!-- PRAWA KOLUMNA: Wybrane produkty i podsumowanie -->
                        <div class="col-md-7 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold mb-3">Wybrane produkty (@VM.SelectedItems.Count)</h6>

                                @if (!VM.SelectedItems.Any())
                                {
                                    <div class="text-center text-muted py-5 border rounded-4 bg-light">
                                        <p class="mb-0">Brak wybranych produktów. Wyszukaj i dodaj produkty z lewej strony.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                        <table class="table align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Produkt</th>
                                                    <th style="width: 130px;">Ilość (g/ml)</th>
                                                    <th>Kcal</th>
                                                    <th>Akcja</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in VM.SelectedItems)
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong class="d-block">@item.Product.ProductName</strong>
                                                            <small class="text-muted">B: @item.Protein.ToString("N0") | T: @item.Fat.ToString("N0") | W: @item.Carbs.ToString("N0")</small>
                                                        </td>
                                                        <td>
                                                            <input type="number" class="form-control form-control-sm" @bind="item.Quantity" min="1" step="1" />
                                                        </td>
                                                        <td>
                                                            <span class="fw-semibold">@item.Calories.ToString("N0") kcal</span>
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => VM.RemoveItem(item)">
                                                                Usuń
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <!-- Podsumowanie makro na żywo -->
                            @if (VM.SelectedItems.Any())
                            {
                                <div class="card bg-light border-0 rounded-4 p-3 mt-3">
                                    <h6 class="fw-bold mb-2">Łączne makro posiłku:</h6>
                                    <div class="row text-center">
                                        <div class="col">
                                            <span class="text-muted small d-block">Kalorie</span>
                                            <strong class="text-primary">@VM.TotalCalories.ToString("N0") kcal</strong>
                                        </div>
                                        <div class="col">
                                            <span class="text-muted small d-block">Białko</span>
                                            <strong>@VM.TotalProtein.ToString("N1") g</strong>
                                        </div>
                                        <div class="col">
                                            <span class="text-muted small d-block">Tłuszcz</span>
                                            <strong>@VM.TotalFat.ToString("N1") g</strong>
                                        </div>
                                        <div class="col">
                                            <span class="text-muted small d-block">Węglowodany</span>
                                            <strong>@VM.TotalCarbs.ToString("N1") g</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="VM.Close">Anuluj</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="VM.ConfirmConsumptionAsync" disabled="@(!VM.SelectedItems.Any())">
                        Zapisz wszystkie (@VM.SelectedItems.Count)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public void Open(MealType mealType)
    {
        VM.Open(mealType);
        StateHasChanged();
    }
}