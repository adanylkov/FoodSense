@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-@Variant alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <strong>@Title</strong> @Message
        </div>
        <button type="button" class="btn-close" @onclick="OnDismiss" aria-label="Close"></button>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    // Bootstrap alert variant, e.g. "success" or "danger".
    [Parameter] public string Variant { get; set; } = "info";
    [Parameter] public EventCallback OnDismiss { get; set; }
}
