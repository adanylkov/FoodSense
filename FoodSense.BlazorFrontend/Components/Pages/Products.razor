@page "/products"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Products</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Products</h1>
            <p class="text-muted mb-0">Create, edit, and remove products through the API.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">@((editingProductId is null) ? "Create a product" : "Edit product")</h2>

                    @if (formModel is { ImageFrontUrl: not null })
                    {
                        <div class="mb-3">
                            <img src="@formModel.ImageFrontUrl" alt="Product Image" class="img-fluid rounded" />
                        </div>
                    }

                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <div class="mb-3">
                            <label class="form-label">Barcode</label>
                            <InputText class="form-control" @bind-Value="formModel.Barcode" @onblur="(e) => HandleBarcodeInput(formModel.Barcode)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="formModel.ProductName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Brands</label>
                            <InputText class="form-control" @bind-Value="formModel.Brands" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <InputText class="form-control" @bind-Value="formModel.ProductQuantity" />
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@isSaving">
                                @((isSaving) ? "Saving..." : "Save")
                            </button>

                            @if (editingProductId is not null)
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">
                                    Cancel
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Existing products</h2>

                    @if (isLoading)
                    {
                        <p class="text-muted">Loading products...</p>
                    }
                    else if (!products.Any())
                    {
                        <p class="text-muted">No products found yet.</p>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-3 g-4">
                            @foreach (var product in products)
                            {
                                <div class="col">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">@product.ProductName</h5>
                                            <p class="card-text"><strong>Barcode:</strong> @product.Barcode</p>
                                            <p class="card-text"><strong>Brands:</strong> @product.Brands</p>
                                            <p class="card-text"><strong>Quantity:</strong> @product.ProductQuantity</p>
                                        </div>
                                        <div class="card-footer">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <button class="btn btn-outline-primary" type="button" @onclick="(() => StartEditing(product))">Edit</button>
                                                <button class="btn btn-outline-danger" type="button" @onclick="(() => DeleteProduct(product.Id))">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mt-3">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <button class="page-link" @onclick="(() => LoadProductsAsync(currentPage - 1))">Previous</button>
                                </li>
                            }
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                int pageNumber = i;
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="(() => LoadProductsAsync(pageNumber))">@i</button>
                                </li>
                            }
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <button class="page-link" @onclick="(() => LoadProductsAsync(currentPage + 1))">Next</button>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<ProductDto> products = [];
    private readonly ProductFormModel formModel = new();
    private int? editingProductId;
    private bool isLoading;
    private bool isSaving;
    private string? message;
    private string? error;

    private int currentPage = 1;
    private int pageSize = 12;
    private int totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync(currentPage);
    }

    private async Task LoadProductsAsync(int page)
    {
        isLoading = true;
        message = null;
        error = null;
        currentPage = page;

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<IEnumerable<ProductDto>>>($"api/Food/GetProducts?page={currentPage}&pageSize={pageSize}");
            if (response != null)
            {
                products.Clear();
                products.AddRange(response.Data ?? Enumerable.Empty<ProductDto>());
                totalPages = (int)Math.Ceiling((double)response.TotalCount / pageSize);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        message = null;
        error = null;

        try
        {
            var payload = new ProductDto
            {
                Id = editingProductId ?? 0,
                Barcode = formModel.Barcode,
                ProductName = formModel.ProductName,
                Brands = formModel.Brands,
                ProductQuantity = formModel.ProductQuantity
            };

            if (editingProductId is null)
            {
                await Http.PostAsJsonAsync("api/Food/CreateProduct", payload);
                message = "Product created.";
            }
            else
            {
                await Http.PutAsJsonAsync($"api/Food/UpdateProduct/{editingProductId}", payload);
                message = "Product updated.";
            }

            ResetForm();
            await LoadProductsAsync(currentPage);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<ProductDto?> GetProductByBarcode(string barcode)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ProductDto>($"api/Food/GetProduct/{barcode}");
            return response;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return null;
        }
    }

    private async Task HandleBarcodeInput(string? barcode)
    {
        if (!string.IsNullOrWhiteSpace(barcode))
        {
            var product = await GetProductByBarcode(barcode);
            if (product != null)
            {
                StartEditing(product);
            }
        }
    }

    private void StartEditing(ProductDto product)
    {
        editingProductId = product.Id;
        formModel.Barcode = product.Barcode;
        formModel.ProductName = product.ProductName;
        formModel.Brands = product.Brands;
        formModel.ProductQuantity = product.ProductQuantity;
        formModel.ImageFrontUrl = product.ImageFrontUrl;
        message = null;
        error = null;
    }

    private void ResetForm()
    {
        editingProductId = null;
        formModel.Barcode = string.Empty;
        formModel.ProductName = string.Empty;
        formModel.Brands = string.Empty;
        formModel.ProductQuantity = string.Empty;
    }

    private async Task DeleteProduct(int id)
    {
        isSaving = true;
        message = null;
        error = null;

        try
        {
            await Http.DeleteAsync($"api/Food/DeleteProduct/{id}");
            message = "Product deleted.";
            await LoadProductsAsync(currentPage);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ProductDto
    {
        public int Id { get; set; }
        public string Barcode { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public string Brands { get; set; } = string.Empty;
        public string ProductQuantity { get; set; } = string.Empty;
        public string? ImageFrontUrl { get; set; }
    }

    private sealed class ApiResponse<T>
    {
        public T? Data { get; set; }
        public int TotalCount { get; set; }
    }

    private sealed class ProductFormModel
    {
        public string Barcode { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public string Brands { get; set; } = string.Empty;
        public string ProductQuantity { get; set; } = string.Empty;
        public string? ImageFrontUrl { get; set; }
    }
}