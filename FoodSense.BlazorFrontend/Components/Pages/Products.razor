@page "/products"
@rendermode InteractiveServer
@using FoodSense.Common.Models
@using FoodSense.ViewModels
@inject ProductsViewModel VM

<PageTitle>FoodSense - Product Catalog</PageTitle>

<div class="bg-body-tertiary border mb-4 rounded-4 p-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2 fw-semibold">
                Inventory Management
            </span>
            <h1 class="h3 fw-bold text-dark mb-1">Product Catalog &amp; Nutrition Engine</h1>
            <p class="text-secondary small mb-0">Create, edit, and audit food products and nutritional data in real-time.</p>
        </div>
    </div>
</div>

<ReceiptUploader OnReceiptItemsAdded="() => VM.LoadProductsAsync(VM.Pagination.CurrentPage)" />

<div>
    <!-- Status Alerts -->
    @if (!string.IsNullOrWhiteSpace(VM.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <strong>Success!</strong> @VM.SuccessMessage
            </div>
            <button type="button" class="btn-close" @onclick="VM.ClearAlerts" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(VM.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <strong>Error:</strong> @VM.ErrorMessage
            </div>
            <button type="button" class="btn-close" @onclick="VM.ClearAlerts" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <ProductForm FormModel="VM.FormModel"
                     EditingProductId="VM.EditingProductId"
                     IsSaving="VM.IsSaving"
                     OnSubmit="VM.SaveProductAsync"
                     OnCancel="VM.ResetForm"
                     OnBarcodeBlur="VM.HandleBarcodeInputAsync" />

        <ProductList Products="VM.Products" 
                     IsLoading="VM.IsLoading" 
                     Pagination="VM.Pagination" 
                     OnPageChanged="VM.LoadProductsAsync" 
                     OnQuickAddPantryItem="VM.QuickAddPantryItemAsync" 
                     OnOpenPantryModal="VM.OpenPantryModal" 
                     OnStartEditing="VM.StartEditing" 
                     OnPromptDelete="VM.PromptDelete" />
    </div>
</div>

<!-- Pantry Modal -->
@if (VM.ActivePantryProduct is not null)
{
    <PantryModal Product="VM.ActivePantryProduct"
                 EditingPantryItemId="VM.EditingPantryItemId"
                 Quantity="VM.PantryFormQuantity"
                 IsSaving="VM.IsSavingPantry"
                 OnQuantityChanged="(e) => Task.FromResult(decimal.TryParse(e.Value?.ToString(), out var q) ? VM.PantryFormQuantity = q : 1)"
                 OnSave="VM.SavePantryItemAsync"
                 OnClose="VM.ClosePantryModal"
                 OnResetForm="VM.ResetPantryForm"
                 OnStartEditingItem="VM.StartEditingPantryItem"
                 OnDeleteItem="VM.DeletePantryItemAsync" />
}

<!-- Delete Confirmation Modal -->
@if (VM.ProductToDeleteId.HasValue)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4 p-2">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">Confirm Deletion</h5>
                    <button type="button" class="btn-close" @onclick="VM.CancelDelete" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-secondary mb-0">Are you sure you want to delete this product? This operation cannot be reversed.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" @onclick="VM.CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold" @onclick="VM.ExecuteDeleteAsync">
                        @if (VM.IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.LoadProductsAsync(VM.Pagination.CurrentPage);
    }
}