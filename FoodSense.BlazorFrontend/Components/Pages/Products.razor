@page "/products"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using FoodSense.Common.Models
@inject HttpClient Http

<PageTitle>FoodSense - Product Catalog</PageTitle>

<!-- Page Header / Banner -->
<div class="bg-body-tertiary border mb-4 rounded-4 p-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2 fw-semibold">
                Inventory Management
            </span>
            <h1 class="h3 fw-bold text-dark mb-1">Product Catalog & Nutrition Engine</h1>
            <p class="text-secondary small mb-0">Create, edit, and audit food products and nutritional data in real-time.</p>
        </div>
    </div>
</div>

<!-- Main Workspace -->
<div>
    <!-- Status Alerts -->
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <strong>Success!</strong> @message
            </div>
            <button type="button" class="btn-close" @onclick="() => message = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <strong>Error:</strong> @error
            </div>
            <button type="button" class="btn-close" @onclick="() => error = null" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Product Form Column -->
        <aside class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 1.5rem; z-index: 10;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h2 class="h5 fw-bold mb-0">
                        @((editingProductId is null) ? "Create New Product" : "Edit Product")
                    </h2>
                    <p class="text-secondary small">Enter barcode to auto-populate details.</p>
                </div>

                <div class="card-body p-4">
                    <!-- Image Preview Box -->
                    <div class="bg-body-tertiary rounded-3 p-3 text-center mb-3 border border-dashed">
                        <img src="@GetImageSource(formModel.FrontImageUrl)" 
                             alt="Product Preview"
                             class="img-fluid rounded-3 object-fit-contain" 
                             style="max-height: 160px;" />
                    </div>

                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <div class="mb-3">
                            <label for="barcodeInput" class="form-label small fw-semibold">Barcode</label>
                            <InputText id="barcodeInput" 
                                       class="form-control rounded-3" 
                                       placeholder="e.g. 5449000000996"
                                       @bind-Value="formModel.Barcode"
                                       @onblur="(e) => HandleBarcodeInput(formModel.Barcode)" />
                        </div>

                        <div class="mb-3">
                            <label for="productNameInput" class="form-label small fw-semibold">Product Name</label>
                            <InputText id="productNameInput" class="form-control rounded-3" placeholder="Item title" @bind-Value="formModel.ProductName" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="brandsInput" class="form-label small fw-semibold">Brands</label>
                                <InputText id="brandsInput" class="form-control rounded-3" placeholder="Brand name" @bind-Value="formModel.Brands" />
                            </div>
                            <div class="col-6">
                                <label for="quantityInput" class="form-label small fw-semibold">Quantity</label>
                                <InputText id="quantityInput" class="form-control rounded-3" placeholder="e.g. 500g" @bind-Value="formModel.ProductQuantity" />
                            </div>
                        </div>

                        <!-- Accordion Form Section for Nutrients -->
                        <div class="accordion mb-4" id="formNutrientAccordion">
                            <div class="accordion-item border rounded-3 overflow-hidden">
                                <h3 class="accordion-header" id="formNutrientHeader">
                                    <button class="accordion-button collapsed bg-body-tertiary shadow-none py-2 px-3 small fw-semibold text-dark" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#formNutrientCollapse" 
                                            aria-expanded="false" 
                                            aria-controls="formNutrientCollapse">
                                        Nutritional Information
                                    </button>
                                </h3>
                                <div id="formNutrientCollapse" class="accordion-collapse collapse" aria-labelledby="formNutrientHeader">
                                    <div class="accordion-body p-3 bg-white">
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label extra-small text-secondary mb-1">Energy (kcal)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.EnergyKcal" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label extra-small text-secondary mb-1">Fat (g)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.Fat" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label extra-small text-secondary mb-1">Sat. Fat (g)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.SaturatedFat" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label extra-small text-secondary mb-1">Carbs (g)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.Carbohydrates" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label extra-small text-secondary mb-1">Sugars (g)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.Sugars" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label extra-small text-secondary mb-1">Proteins (g)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.Proteins" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label extra-small text-secondary mb-1">Salt (g)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="formModel.Nutrients.Salt" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary w-100 rounded-3 py-2 fw-semibold" type="submit" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Product</span>
                                }
                            </button>

                            @if (editingProductId is not null)
                            {
                                <button class="btn btn-light border w-100 rounded-3 py-2 text-secondary fw-semibold" type="button" @onclick="ResetForm">
                                    Cancel
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </aside>

        <!-- Product Cards Grid Column -->
        <section class="col-lg-8" aria-labelledby="catalog-heading">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 id="catalog-heading" class="h5 fw-bold mb-0">Existing Catalog</h2>
                <span class="badge bg-body-tertiary text-secondary border px-3 py-2 rounded-pill fw-normal">
                    Page @currentPage of @(totalPages == 0 ? 1 : totalPages)
                </span>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5 my-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading products...</span>
                    </div>
                    <p class="text-secondary">Fetching product database...</p>
                </div>
            }
            else if (!products.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                    <div class="card-body">
                        <h3 class="h5 fw-bold mb-2">No Products Found</h3>
                        <p class="text-secondary mb-0">Use the form on the left to add your first food item.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var product in products)
                    {
                        <div class="col">
                            <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column">
                                <div class="position-relative bg-body-tertiary text-center p-3">
                                    <img src="@GetImageSource(product.FrontImageUrl)" 
                                         alt="@product.ProductName"
                                         class="card-img-top object-fit-contain" 
                                         style="height: 180px;" />
                                    <span class="position-absolute top-0 end-0 m-3 badge bg-white text-dark border shadow-sm rounded-pill">
                                        @product.ProductQuantity
                                    </span>
                                </div>

                                <div class="card-body p-4 d-flex flex-column">
                                    <span class="text-secondary extra-small fw-semibold text-uppercase mb-1">@product.Brands</span>
                                    <h3 class="h6 card-title fw-bold text-dark mb-2 text-truncate">@product.ProductName</h3>
                                    <p class="card-text small text-secondary mb-3">
                                        <strong>Barcode:</strong> <code>@product.Barcode</code>
                                    </p>

                                    <!-- Unique Accordion Instance Per Product Nutrients -->
                                    <div class="accordion mt-auto mb-3" id="@($"nutrientAccordion-{product.Id}")">
                                        <div class="accordion-item border-0 bg-body-tertiary rounded-3 overflow-hidden">
                                            <h4 class="accordion-header" id="@($"nutrientHeader-{product.Id}")">
                                                <button class="accordion-button collapsed shadow-none bg-body-tertiary p-2 px-3 small fw-semibold text-secondary" 
                                                        type="button"
                                                        data-bs-toggle="collapse" 
                                                        data-bs-target="@($"#nutrientBody-{product.Id}")"
                                                        aria-expanded="false" 
                                                        aria-controls="@($"nutrientBody-{product.Id}")">
                                                    Nutritional Value
                                                </button>
                                            </h4>
                                            <div id="@($"nutrientBody-{product.Id}")" class="accordion-collapse collapse">
                                                <div class="accordion-body p-3 bg-white border-top extra-small">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-secondary">Energy:</span>
                                                        <span class="fw-bold">@product.Nutrients?.EnergyKcal kcal</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-secondary">Fat:</span>
                                                        <span class="fw-bold">@product.Nutrients?.Fat g</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-secondary">Saturated Fat:</span>
                                                        <span class="fw-bold">@product.Nutrients?.SaturatedFat g</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-secondary">Carbohydrates:</span>
                                                        <span class="fw-bold">@product.Nutrients?.Carbohydrates g</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-secondary">Sugars:</span>
                                                        <span class="fw-bold">@product.Nutrients?.Sugars g</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-secondary">Proteins:</span>
                                                        <span class="fw-bold">@product.Nutrients?.Proteins g</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between">
                                                        <span class="text-secondary">Salt:</span>
                                                        <span class="fw-bold">@product.Nutrients?.Salt g</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Quick Pantry Summary & Direct Action -->
                                    <div class="p bg-body-tertiary rounded-3 p-2.5 mb-3 d-flex align-items-center justify-content-between">
                                        <div class="extra-small">
                                            <span class="text-secondary">In Pantry: </span>
                                            <span class="fw-bold text-dark">@(product.PantryItems?.Count() ?? 0) item(s)</span>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-primary btn-sm extra-small py-1 px-2 rounded-2 fw-semibold" 
                                                    title="Quick add 1 item to pantry"
                                                    @onclick="(() => QuickAddPantryItem(product.Id))">
                                                +1
                                            </button>
                                            <button class="btn btn-outline-secondary btn-sm extra-small py-1 px-2 rounded-2 fw-semibold" 
                                                    @onclick="(() => OpenPantryModal(product))">
                                                Manage
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Card Actions -->
                                    <div class="d-flex gap-2 border-top pt-3">
                                        <button class="btn btn-light-subtle border text-primary btn-sm w-100 rounded-3 fw-semibold" 
                                                type="button"
                                                @onclick="(() => StartEditing(product))">
                                            Edit
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm w-100 rounded-3 fw-semibold" 
                                                type="button"
                                                @onclick="(() => PromptDelete(product.Id))">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <!-- Pagination Navigation -->
                <nav aria-label="Product pagination" class="mt-4">
                    <ul class="pagination justify-content-center gap-1">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link rounded-3 border-0 shadow-sm px-3" 
                                    @onclick="(() => LoadProductsAsync(currentPage - 1))"
                                    disabled="@(currentPage <= 1)">
                                Previous
                            </button>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            int pageNumber = i;
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <button class="page-link rounded-3 border-0 shadow-sm px-3" @onclick="(() => LoadProductsAsync(pageNumber))">
                                    @i
                                </button>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link rounded-3 border-0 shadow-sm px-3" 
                                    @onclick="(() => LoadProductsAsync(currentPage + 1))"
                                    disabled="@(currentPage >= totalPages)">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            }
        </section>
    </div>
</div>

<!-- Pantry Management Modal -->
@if (activePantryProduct is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3">
                    <div>
                        <h5 class="modal-title fw-bold text-dark">Manage Pantry - @activePantryProduct.ProductName</h5>
                        <p class="text-secondary extra-small mb-0">Barcode: @activePantryProduct.Barcode</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="ClosePantryModal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4 bg-body-tertiary">
                    <!-- Create New Pantry Item Form -->
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-body p-3">
                            <h6 class="fw-bold extra-small text-uppercase text-secondary mb-2">
                                @(editingPantryItemId.HasValue ? "Edit Pantry Item" : "Add New Pantry Instance")
                            </h6>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label extra-small text-secondary mb-1">Quantity</label>
                                    <input type="number" min="1" class="form-control form-control-sm" @bind="pantryFormQuantity" />
                                </div>
                                <div class="col-md-3">
                                    <div class="d-flex gap-1">
                                        <button type="button" 
                                                class="btn btn-primary btn-sm w-100 fw-semibold extra-small" 
                                                disabled="@isSavingPantry"
                                                @onclick="SavePantryItemAsync">
                                            @if (isSavingPantry)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <span>@(editingPantryItemId.HasValue ? "Update" : "Add")</span>
                                            }
                                        </button>
                                        @if (editingPantryItemId.HasValue)
                                        {
                                            <button type="button" class="btn btn-light border btn-sm extra-small" @onclick="ResetPantryForm">
                                                Cancel
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Existing Items List -->
                    <h6 class="fw-bold extra-small text-uppercase text-secondary mb-2 px-1">Registered Stock Entries</h6>
                    @if (activePantryProduct.PantryItems != null && activePantryProduct.PantryItems.Any())
                    {
                        <div class="list-group shadow-sm rounded-3 border-0 overflow-hidden">
                            @foreach (var item in activePantryProduct.PantryItems)
                            {
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-bottom last-child-border-0">
                                    <div>
                                        <div class="fw-bold text-dark">Quantity: @item.Quantity</div>
                                        <div class="text-secondary extra-small">
                                            Added: @item.AddedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-light border btn-sm extra-small fw-semibold" @onclick="(() => StartEditingPantryItem(item))">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm extra-small fw-semibold" @onclick="(() => DeletePantryItemAsync(item.Id))">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4 bg-white rounded-3 border">
                            <p class="text-secondary extra-small mb-0 fst-italic">No active pantry items recorded for this product.</p>
                        </div>
                    }
                </div>

                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-3 px-4 fw-semibold" @onclick="ClosePantryModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Product Confirmation Modal -->
@if (productToDeleteId.HasValue)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4 p-2">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">Confirm Deletion</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-secondary mb-0">Are you sure you want to delete this product? This operation cannot be reversed.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold" @onclick="ExecuteDelete">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .extra-small { font-size: 0.75rem; }
    .border-dashed { border-style: dashed !important; }
    .last-child-border-0:last-child { border-bottom: none !important; }
</style>

@code {
    private const string PlaceholderImagePath = "/images/product-placeholder.svg";

    private readonly List<ProductDto> products = [];
    private readonly ProductDto formModel = new();
    private int? editingProductId;
    private int? productToDeleteId;
    private bool isLoading;
    private bool isSaving;
    private string? message;
    private string? error;

    private int currentPage = 1;
    private int pageSize = 12;
    private int totalPages;

    // Modal state for Pantry Management
    private ProductDto? activePantryProduct;
    private int? editingPantryItemId;
    private decimal pantryFormQuantity = 1;
    private bool isSavingPantry;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync(currentPage);
    }

    private async Task LoadProductsAsync(int page)
    {
        isLoading = true;
        message = null;
        error = null;
        currentPage = page;

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<IEnumerable<ProductDto>>>($"api/Food/GetProducts?page={currentPage}&pageSize={pageSize}");
            if (response != null)
            {
                products.Clear();
                products.AddRange(response.Data ?? Enumerable.Empty<ProductDto>());
                totalPages = (int)Math.Ceiling((double)response.TotalCount / pageSize);

                // If pantry modal is open, refresh active product reference
                if (activePantryProduct != null)
                {
                    activePantryProduct = products.FirstOrDefault(p => p.Id == activePantryProduct.Id);
                }
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    /* ---------------------- PANTRY CONTROLLER CALLS ---------------------- */

    private async Task QuickAddPantryItem(int productId)
    {
        try
        {
            var response = await Http.PostAsync($"api/Pantry/AddProductToPantry/{productId}", null);
            if (response.IsSuccessStatusCode)
            {
                message = "Pantry item added.";
                await LoadProductsAsync(currentPage);
            }
            else
            {
                error = "Failed to add item to pantry.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task SavePantryItemAsync()
    {
        if (activePantryProduct == null || pantryFormQuantity <= 0) return;

        isSavingPantry = true;
        error = null;

        try
        {
            var pantryPayload = new PantryItemDto
            {
                Id = editingPantryItemId ?? 0,
                Quantity = pantryFormQuantity,
                AddedAt = DateTime.UtcNow
            };

            HttpResponseMessage response;

            if (editingPantryItemId.HasValue)
            {
                // Update Pantry Item
                response = await Http.PutAsJsonAsync($"api/Pantry/UpdatePantryItem/{editingPantryItemId.Value}", pantryPayload);
            }
            else
            {
                // Create New Pantry Item via query param productId
                response = await Http.PostAsJsonAsync($"api/Pantry/CreatePantryItem?productId={activePantryProduct.Id}", pantryPayload);
                var message = await response.Content.ReadAsStringAsync(); // Ensure content is read to avoid potential issues
            }

            if (response.IsSuccessStatusCode)
            {
                ResetPantryForm();
                await LoadProductsAsync(currentPage);
            }
            else
            {
                error = "Failed to save pantry item.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSavingPantry = false;
        }
    }

    private async Task DeletePantryItemAsync(int pantryItemId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Pantry/DeletePantryItem/{pantryItemId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadProductsAsync(currentPage);
            }
            else
            {
                error = "Failed to delete pantry item.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void OpenPantryModal(ProductDto product)
    {
        activePantryProduct = product;
        ResetPantryForm();
    }

    private void ClosePantryModal()
    {
        activePantryProduct = null;
        ResetPantryForm();
    }

    private void StartEditingPantryItem(PantryItemDto item)
    {
        editingPantryItemId = item.Id;
        pantryFormQuantity = item.Quantity;
    }

    private void ResetPantryForm()
    {
        editingPantryItemId = null;
        pantryFormQuantity = 1;
    }

    /* ---------------------- PRODUCT CATALOG METHODS ---------------------- */

    private async Task HandleSubmit()
    {
        isSaving = true;
        message = null;
        error = null;

        try
        {
            var payload = new ProductDto
            {
                Id = editingProductId ?? 0,
                Barcode = formModel.Barcode,
                ProductName = formModel.ProductName,
                Brands = formModel.Brands,
                ProductQuantity = formModel.ProductQuantity,
                FrontImageUrl = formModel.FrontImageUrl,
                Nutrients = formModel.Nutrients
            };

            if (editingProductId is null)
            {
                var response = await Http.PostAsJsonAsync("api/Food/CreateProduct", payload);
                if (!response.IsSuccessStatusCode)
                {
                    var errorMsg = await response.Content.ReadAsStringAsync();
                    message = $"Failed to create product: {errorMsg}";
                }
                else
                {
                    message = "Product created successfully.";
                }
            }
            else
            {
                await Http.PutAsJsonAsync($"api/Food/UpdateProduct/{editingProductId}", payload);
                message = "Product updated successfully.";
            }

            ResetForm();
            await LoadProductsAsync(currentPage);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<ProductDto?> GetProductByBarcode(string barcode)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ProductDto>($"api/Food/GetProduct/{barcode}");
            return response;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return null;
        }
    }

    private async Task HandleBarcodeInput(string? barcode)
    {
        if (!string.IsNullOrWhiteSpace(barcode))
        {
            var product = await GetProductByBarcode(barcode);
            if (product != null)
            {
                StartEditing(product);
            }
        }
    }

    private void StartEditing(ProductDto product)
    {
        editingProductId = product.Id;
        formModel.Barcode = product.Barcode;
        formModel.ProductName = product.ProductName;
        formModel.Brands = product.Brands;
        formModel.ProductQuantity = product.ProductQuantity;
        formModel.FrontImageUrl = product.FrontImageUrl;
        formModel.Nutrients = product.Nutrients ?? new NutrientsDto();
        message = null;
        error = null;
    }

    private string GetImageSource(string? imageUrl)
        => string.IsNullOrWhiteSpace(imageUrl) ? PlaceholderImagePath : imageUrl;

    private void ResetForm()
    {
        editingProductId = null;
        formModel.Barcode = string.Empty;
        formModel.ProductName = string.Empty;
        formModel.Brands = string.Empty;
        formModel.ProductQuantity = string.Empty;
        formModel.FrontImageUrl = null;
        formModel.Nutrients = new NutrientsDto();
    }

    private void PromptDelete(int id)
    {
        productToDeleteId = id;
    }

    private void CancelDelete()
    {
        productToDeleteId = null;
    }

    private async Task ExecuteDelete()
    {
        if (!productToDeleteId.HasValue) return;

        isSaving = true;
        message = null;
        error = null;

        try
        {
            await Http.DeleteAsync($"api/Food/DeleteProduct/{productToDeleteId.Value}");
            message = "Product deleted successfully.";
            productToDeleteId = null;
            await LoadProductsAsync(currentPage);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}