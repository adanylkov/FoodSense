@page "/products"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Products</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Products</h1>
            <p class="text-muted mb-0">Create, edit, and remove products through the API.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">@((editingProductId is null) ? "Create a product" : "Edit product")</h2>

                    <div class="mb-3">
                        <img src="@GetImageSource(formModel.FrontImageUrl)" alt="Product Image"
                             class="img-fluid rounded" />
                    </div>

                    <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                        <div class="mb-3">
                            <label class="form-label">Barcode</label>
                            <InputText class="form-control" @bind-Value="formModel.Barcode"
                                       @onblur="(e) => HandleBarcodeInput(formModel.Barcode)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="formModel.ProductName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Brands</label>
                            <InputText class="form-control" @bind-Value="formModel.Brands" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <InputText class="form-control" @bind-Value="formModel.ProductQuantity" />
                        </div>

                        <div class="mb-3 mt-3">
                            <label class="form-label">Nutrients</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Energy (kcal)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.EnergyKcal" />
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Fat (g)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.Fat" />
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Saturated Fat (g)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.SaturatedFat" />
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Carbohydrates (g)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.Carbohydrates" />
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Sugars (g)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.Sugars" />
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Proteins (g)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.Proteins" />
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">Salt (g)</span>
                                <InputNumber class="form-control" @bind-Value="formModel.Nutrients.Salt" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@isSaving">
                                @((isSaving) ? "Saving..." : "Save")
                            </button>

                            @if (editingProductId is not null)
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">
                                    Cancel
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Existing products</h2>

                    @if (isLoading)
                    {
                        <p class="text-muted">Loading products...</p>
                    }
                    else if (!products.Any())
                    {
                        <p class="text-muted">No products found yet.</p>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-3 g-4">
                            @foreach (var product in products)
                            {
                                <div class="col">
                                    <div class="card h-100">
                                        <img src="@GetImageSource(product.FrontImageUrl)" alt="@product.ProductName"
                                             class="card-img-top" style="height: 200px; object-fit: cover;" />
                                        <div class="card-body">
                                            <h5 class="card-title">@product.ProductName</h5>
                                            <p class="card-text mb-1"><strong>Barcode:</strong> @product.Barcode</p>
                                            <p class="card-text mb-1"><strong>Brands:</strong> @product.Brands</p>
                                            <p class="card-text mb-1"><strong>Quantity:</strong> @product.ProductQuantity</p>
                                        </div>

                                        <!-- Accordion for Nutrients -->
                                        <div class="accordion" id="nutrientAccordion">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="nutrientHeader">
                                                    <button class="accordion-button collapsed" type="button"
                                                            data-bs-toggle="collapse" data-bs-target="#nutrientBody"
                                                            aria-expanded="false" aria-controls="nutrientBody">
                                                        Nutrients
                                                    </button>
                                                </h2>
                                                <!-- Outer div handles the collapse animation -->
                                                <div id="nutrientBody" class="accordion-collapse collapse">
                                                    <!-- Inner div handles the padding and content -->
                                                    <div class="accordion-body">
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Energy (kcal):</span>
                                                            <strong>@product.Nutrients.EnergyKcal</strong>
                                                        </div>
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Fat (g):</span>
                                                            <strong>@product.Nutrients.Fat</strong>
                                                        </div>
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Saturated Fat (g):</span>
                                                            <strong>@product.Nutrients.SaturatedFat</strong>
                                                        </div>
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Carbohydrates (g):</span>
                                                            <strong>@product.Nutrients.Carbohydrates</strong>
                                                        </div>
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Sugars (g):</span>
                                                            <strong>@product.Nutrients.Sugars</strong>
                                                        </div>
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Proteins (g):</span>
                                                            <strong>@product.Nutrients.Proteins</strong>
                                                        </div>
                                                        <div class="mb-1">
                                                            <span class="text-secondary">Salt (g):</span>
                                                            <strong>@product.Nutrients.Salt</strong>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-footer mt-auto">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <button class="btn btn-outline-primary btn-sm" type="button"
                                                        @onclick="(() => StartEditing(product))">Edit</button>
                                                <button class="btn btn-outline-danger btn-sm" type="button"
                                                        @onclick="(() => DeleteProduct(product.Id))">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mt-3">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <button class="page-link"
                                            @onclick="(() => LoadProductsAsync(currentPage - 1))">Previous</button>
                                </li>
                            }
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                int pageNumber = i;
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="(() => LoadProductsAsync(pageNumber))">@i</button>
                                </li>
                            }
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <button class="page-link"
                                            @onclick="(() => LoadProductsAsync(currentPage + 1))">Next</button>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string PlaceholderImagePath = "/images/product-placeholder.svg";

    private readonly List<ProductDto> products = [];
    private readonly ProductFormModel formModel = new();
    private int? editingProductId;
    private bool isLoading;
    private bool isSaving;
    private string? message;
    private string? error;

    private int currentPage = 1;
    private int pageSize = 12;
    private int totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync(currentPage);
    }

    private async Task LoadProductsAsync(int page)
    {
        isLoading = true;
        message = null;
        error = null;
        currentPage = page;

        try
        {
            var response = await
Http.GetFromJsonAsync<ApiResponse<IEnumerable<ProductDto>>>($"api/Food/GetProducts?page={currentPage}&pageSize={pageSize}");
            if (response != null)
            {
                products.Clear();
                products.AddRange(response.Data ?? Enumerable.Empty<ProductDto>());
                totalPages = (int)Math.Ceiling((double)response.TotalCount / pageSize);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        message = null;
        error = null;

        try
        {
            var payload = new ProductDto
            {
                Id = editingProductId ?? 0,
                Barcode = formModel.Barcode,
                ProductName = formModel.ProductName,
                Brands = formModel.Brands,
                ProductQuantity = formModel.ProductQuantity,
                FrontImageUrl = formModel.FrontImageUrl
            };

            if (editingProductId is null)
            {
                await Http.PostAsJsonAsync("api/Food/CreateProduct", payload);
                message = "Product created.";
            }
            else
            {
                await Http.PutAsJsonAsync($"api/Food/UpdateProduct/{editingProductId}", payload);
                message = "Product updated.";
            }

            ResetForm();
            await LoadProductsAsync(currentPage);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<ProductDto?> GetProductByBarcode(string barcode)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ProductDto>($"api/Food/GetProduct/{barcode}");
            return response;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return null;
        }
    }

    private async Task HandleBarcodeInput(string? barcode)
    {
        if (!string.IsNullOrWhiteSpace(barcode))
        {
            var product = await GetProductByBarcode(barcode);
            if (product != null)
            {
                StartEditing(product);
            }
        }
    }

    private void StartEditing(ProductDto product)
    {
        editingProductId = product.Id;
        formModel.Barcode = product.Barcode;
        formModel.ProductName = product.ProductName;
        formModel.Brands = product.Brands;
        formModel.ProductQuantity = product.ProductQuantity;
        formModel.FrontImageUrl = product.FrontImageUrl;
        message = null;
        error = null;
    }

    private string GetImageSource(string? imageUrl)
        => string.IsNullOrWhiteSpace(imageUrl) ? PlaceholderImagePath : imageUrl;

    private void ResetForm()
    {
        editingProductId = null;
        formModel.Barcode = string.Empty;
        formModel.ProductName = string.Empty;
        formModel.Brands = string.Empty;
        formModel.ProductQuantity = string.Empty;
        formModel.FrontImageUrl = null;
    }

    private async Task DeleteProduct(int id)
    {
        isSaving = true;
        message = null;
        error = null;

        try
        {
            await Http.DeleteAsync($"api/Food/DeleteProduct/{id}");
            message = "Product deleted.";
            await LoadProductsAsync(currentPage);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class Nutrients
    {
        public double EnergyKcal { get; set; }
        public double Fat { get; set; }
        public double SaturatedFat { get; set; }
        public double Carbohydrates { get; set; }
        public double Sugars { get; set; }
        public double Proteins { get; set; }
        public double Salt { get; set; }
    }

    private sealed class ProductDto
    {
        public int Id { get; set; }
        public string Barcode { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public string Brands { get; set; } = string.Empty;
        public string ProductQuantity { get; set; } = string.Empty;
        public string? FrontImageUrl { get; set; }
        public Nutrients Nutrients { get; set; } = new();
    }

    private sealed class ProductFormModel
    {
        public string Barcode { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public string Brands { get; set; } = string.Empty;
        public string ProductQuantity { get; set; } = string.Empty;
        public string? FrontImageUrl { get; set; }
        public Nutrients Nutrients { get; set; } = new();
    }

    private sealed class ApiResponse<T>
    {
        public T? Data { get; set; }
        public int TotalCount { get; set; }
    }

}