@page "/tracker"
@rendermode InteractiveServer
@using FoodSense.BlazorFrontend.ViewModels
@using FoodSense.Common.Models
@inherits ViewModelComponent<CalorieTrackerListViewModel>

<PageTitle>Tracker Kalorii</PageTitle>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0">Dziennik Kalorii</h2>
        <input type="date" class="form-control w-auto" value="@VM.SelectedDate.ToString("yyyy-MM-dd")"
               @onchange="VM.ChangeDateAsync" />
    </div>

    @if (VM.IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-secondary mt-2">Ładowanie dziennika...</p>
        </div>
    }
    else
    {
        <!-- Podsumowanie celów -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card p-3 shadow-sm rounded-4 border-0">
                    <span class="text-secondary small">Kalorie</span>
                    <h3 class="fw-bold mb-0">@VM.TotalNutrients.Calories.ToString("N0") <span class="fs-6 text-muted">/
                        @VM.Goals.TargetCalories kcal</span></h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm rounded-4 border-0">
                        <span class="text-secondary small">Białko</span>
                        <h4 class="fw-bold mb-0">@VM.TotalNutrients.Protein.ToString("N1") <span class="fs-6 text-muted">/
                            @VM.Goals.TargetProtein g</span></h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card p-3 shadow-sm rounded-4 border-0">
                            <span class="text-secondary small">Tłuszcz</span>
                            <h4 class="fw-bold mb-0">@VM.TotalNutrients.Fat.ToString("N1") <span class="fs-6 text-muted">/ @VM.Goals.TargetFat
                                g</span></h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-3 shadow-sm rounded-4 border-0">
                                <span class="text-secondary small">Węglowodany</span>
                                <h4 class="fw-bold mb-0">@VM.TotalNutrients.Carbs.ToString("N1") <span class="fs-6 text-muted">/
                                    @VM.Goals.TargetCarbs g</span></h4>
                                </div>
                            </div>
                        </div>

                        <!-- Sekcje posiłków -->
                        @foreach (MealType mealType in Enum.GetValues(typeof(MealType)))
                        {
                            // Tworzymy lokalną kopię zmiennej dla domknięcia (closure) w lambdzie
                            var currentMeal = mealType;

                            <div class="card mb-3 shadow-sm rounded-4 border-0">
                                <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                                    <h5 class="mb-0 fw-bold">@currentMeal</h5>
                                    <!-- Używamy lokalnej zmiennej currentMeal zamiast mealType -->
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => _addProductModal?.Open(currentMeal)">
                                        + Dodaj produkt
                                    </button>
                                </div>
                                <div class="card-body">
                                    @{
                                        var entries = VM.LogEntries.Where(e => e.MealType == currentMeal).ToList();
                                    }
                                    @if (!entries.Any())
                                    {
                                        <p class="text-muted mb-0 small fst-italic">Brak wpisów dla tego posiłku.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var entry in entries)
                                            {
                                                <li class="list-group-item d-none d-md-flex justify-content-between align-items-center gap-3 px-0">
                                                    <div class="text-break">
                                                        <span class="fw-semibold">@entry.Product.Name</span>
                                                        <span class="text-muted small ms-2">@entry.ConsumedQuantity.ToString("N0")g</span>
                                                    </div>
                                                    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                                                        <span class="badge kcal-color text-light border">@entry.Nutritions.Calories.ToString("N0") kcal</span>
                                                        <span class="badge protein-color text-light border">Białko: @entry.Nutritions.Protein.ToString("N0")g</span>
                                                        <span class="badge fat-color text-light border">Tłuszcz: @entry.Nutritions.Fat.ToString("N0")g</span>
                                                        <span class="badge carbs-color text-light border">Węglowodany: @entry.Nutritions.Carbs.ToString("N0")g</span>
                                                        <span class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(entry)">Edit</span>
                                                    </div>
                                                </li>
                                                <li class="list-group-item d-md-none px-0">
                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                        <span class="fw-semibold text-break">@entry.Product.Name</span>
                                                        <span class="text-muted small text-nowrap">@entry.ConsumedQuantity.ToString("N0")g</span>
                                                    </div>
                                                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                                        <span class="protein-color small fw-semibold text-nowrap">B: @entry.Nutritions.Protein.ToString("N0")g</span>
                                                        <span class="fat-color small fw-semibold text-nowrap">T: @entry.Nutritions.Fat.ToString("N0")g</span>
                                                        <span class="carbs-color small fw-semibold text-nowrap">W: @entry.Nutritions.Carbs.ToString("N0")g</span>
                                                        <span class="kcal-color small fw-semibold text-nowrap">@entry.Nutritions.Calories.ToString("N0") kcal</span>
                                                        <span class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => OpenEditModal(entry)">Edit</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

<AddCalorieTrackerModal @ref="_addProductModal" />
<EditCalorieTrackerModal @ref="_editCalorieTrackerModal" />

@code {
    private AddCalorieTrackerModal? _addProductModal = null!;
    private EditCalorieTrackerModal? _editCalorieTrackerModal = null!;

    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAsync();
    }

    private void OpenEditModal(FoodSense.API.Data.Models.FoodLogEntry entry)
    {
        _editCalorieTrackerModal?.Open(entry);
    }
}