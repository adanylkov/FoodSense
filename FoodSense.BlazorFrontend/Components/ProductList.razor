@using FoodSense.Common.Models
@inherits ViewModelComponent<ProductListViewModel>

<section class="col-lg-8" aria-labelledby="catalog-heading">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 id="catalog-heading" class="h5 fw-bold mb-0">Existing Catalog</h2>
        <span class="badge bg-body-tertiary text-secondary border px-3 py-2 rounded-pill fw-normal">
            Page @VM.Pagination.CurrentPage of @(VM.Pagination.TotalPages == 0 ? 1 : VM.Pagination.TotalPages)
        </span>
    </div>

    <div class="nav nav-tabs mb-4" role="tablist" aria-label="Product catalog filters">
        <button class="nav-link @(VM.PantryOnly ? "" : "active")" type="button"
                aria-selected="@(!VM.PantryOnly)" @onclick="() => VM.SetPantryOnlyAsync(false)">
            All products
        </button>
        <button class="nav-link @(VM.PantryOnly ? "active" : "")" type="button"
                aria-selected="@VM.PantryOnly" @onclick="() => VM.SetPantryOnlyAsync(true)">
            Products in stock
        </button>
    </div>

    <div class="btn-group mb-4" role="group" aria-label="Product catalog view type">
        <button class=@($"btn btn-{(VM.ViewType == ProductListViewType.List ? "primary" : "outline-primary")}") @onclick="() => VM.ViewType = ProductListViewType.List">
            List View
        </button>
        <button class=@($"btn btn-{(VM.ViewType == ProductListViewType.Grid ? "primary" : "outline-primary")}") @onclick="() => VM.ViewType = ProductListViewType.Grid">
            Grid View
        </button>
    </div>

    @if (VM.IsLoading)
    {
        <div class="text-center py-5 my-5">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading products...</span>
            </div>
            <p class="text-secondary">Fetching product database...</p>
        </div>
    }
    else if (VM.Products.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="card-body">
                <h3 class="h5 fw-bold mb-2">No Products Found</h3>
                <p class="text-secondary mb-0">Use the form on the left to add your first food item.</p>
            </div>
        </div>
    }
    else
    {
        @if (VM.ViewType == ProductListViewType.Grid)
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in VM.Products)
                {
                    <ProductCard @key="product.Id" Product="product" />
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var product in VM.Products)
                {
                    <ProductListItem @key="product.Id" Product="product" />
                }
            </div>
        }


        <PaginationControls Pagination="VM.Pagination" OnPageChanged="VM.LoadAsync" />
    }
</section>

@code {
    protected override Task OnInitializedAsync() => VM.LoadAsync(VM.Pagination.CurrentPage);
}
