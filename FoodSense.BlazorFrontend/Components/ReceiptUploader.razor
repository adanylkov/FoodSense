@using System.Diagnostics
@using FoodSense.Common.Models
@using FoodSense.ReceiptReader
@using FoodSense.Services
@inject IReceiptReaderFactory ReceiptReaderFactory
@inject HttpClient Http
@inject IProductApiService productApiService

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div>
                <h2 class="h5 fw-bold text-dark mb-1">Upload receipt JSON</h2>
                <p class="text-secondary small mb-0">Parse a receipt and review items before adding them to your pantry.</p>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 align-items-center">
            <InputFile OnChange="HandleReceiptFileSelected" accept=".json,application/json" class="form-control w-auto" />
        </div>

        @if (isLoadingReceipt)
        {
            <div class="d-flex align-items-center gap-2 mt-3 text-secondary">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Parsing receipt...</span>
            </div>
        }

        @if (receiptPreviewItems.Count > 0)
        {
            <div class="mt-4 border rounded-4 overflow-hidden">
                <div class="d-flex justify-content-between align-items-center gap-3 px-3 py-2 bg-body-tertiary border-bottom">
                    <div class="fw-semibold text-dark">Receipt preview</div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked="@AllReceiptItemsSelected" @onchange="ToggleSelectAllReceiptItems" />
                        <label class="form-check-label small text-secondary">Select all</label>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 48px;"></th>
                                <th>Name</th>
                                <th>Barcode</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in receiptPreviewItems)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" checked="@item.IsSelected" @onchange="(e => ToggleReceiptItemSelection(item, (bool?)e.Value ?? false))" />
                                    </td>
                                    <td>@(item.IsMatched ? item.MatchedProductName : item.Item.ProductName)</td>
                                    @if (item is {IsMatched: true, MatchedBarcode: not null})
                                    {
                                        <td>@item.MatchedBarcode</td>
                                    }
                                    else
                                    {
                                        <td>
                                            <input type="number" class="form-control form-control-sm" placeholder="Enter barcode" @onchange="(e) => OnBarcodeChanged(e, item)"/>
                                        </td>
                                    }
                                    <td>@item.Item.Barcode</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top bg-white">
                    <button class="btn btn-primary rounded-3 fw-semibold" type="button" @onclick="ConfirmReceiptItemsAsync" disabled="@isAddingReceiptItems">
                        @if (isAddingReceiptItems)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            <span>Adding...</span>
                        }
                        else
                        {
                            <span>Confirm &amp; Add to Pantry</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <strong class="text-danger">Error:</strong> @error
        </div>
        <button type="button" class="btn-close" @onclick="() => error = null" aria-label="Close"></button>
    </div>
}

@code {
    [Parameter] public EventCallback OnReceiptItemsAdded { get; set; }

    private bool isLoadingReceipt;
    private bool isAddingReceiptItems;
    private string? error;
    private List<ReceiptPreviewItem> receiptPreviewItems = [];

    private bool isLoadingMatch;
    private ApiResponse<IEnumerable<ProductMappingDto>>? matchedProducts;

    private sealed class ReceiptPreviewItem
    {
        public required ProductDto Item { get; init; }
        public bool IsSelected { get; set; } = true;
        public bool IsMatched { get; set; } = false;
        public string? MatchedBarcode { get; set; }
        public string? MatchedProductName { get; set; }
    }

    private bool AllReceiptItemsSelected => receiptPreviewItems.Count > 0 && receiptPreviewItems.All(item => item.IsSelected);

    private async Task HandleReceiptFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null) return;

        if (!file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            error = "Only .json receipt files are supported.";
            receiptPreviewItems.Clear();
            return;
        }

        isLoadingReceipt = true;
        error = null;

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var reader = ReceiptReaderFactory.GetReader(Path.GetExtension(file.Name));
            var items = await reader.ReadAsync(stream);
            receiptPreviewItems = items
                .Select(item => new ReceiptPreviewItem { Item = item, IsSelected = true })
                .ToList();

            if (receiptPreviewItems.Count > 0)
            {
                await MatchProductsAsync();
            }

            if (receiptPreviewItems.Count == 0)
            {
                error = "No receipt items could be parsed from this file.";
            }
        }
        catch (Exception ex)
        {
            error = $"Unable to parse the receipt file: {ex.Message}";
            receiptPreviewItems.Clear();
        }
        finally
        {
            isLoadingReceipt = false;
        }
    }

    private async Task MatchProductsAsync()
    {
        isLoadingMatch = true;
        matchedProducts = null;
        try
        {
            var names = receiptPreviewItems
                .Where(i => i.IsSelected)
                .Select(i => i.Item.ProductName)
                .ToList();

            if (names.Any())
            {
                var response = await Http.PostAsJsonAsync("api/productmatching/match", names);
                if (response.IsSuccessStatusCode)
                {
                    matchedProducts = await response.Content.ReadFromJsonAsync<ApiResponse<IEnumerable<ProductMappingDto>>>();

                    foreach (var (i, item) in matchedProducts?.Data?.Index() ?? [])
                    {
                        if (receiptPreviewItems is null) continue;
                        if (receiptPreviewItems.Count <= i) break;
                        if (string.IsNullOrWhiteSpace(item.Barcode)) continue;

                        var receiptPreviewItem = receiptPreviewItems[i];

                        receiptPreviewItem.IsMatched = true;
                        receiptPreviewItem.MatchedBarcode = item.Barcode;
                        receiptPreviewItem.MatchedProductName = item.ProductName;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            error = $"Error matching products: {ex.Message}";
        }
        finally
        {
            isLoadingMatch = false;
        }
    }

    private void ToggleReceiptItemSelection(ReceiptPreviewItem item, bool isSelected)
    {
        item.IsSelected = isSelected;
    }

    private void ToggleSelectAllReceiptItems(ChangeEventArgs args)
    {
        var isChecked = args.Value as bool? ?? false;
        foreach (var item in receiptPreviewItems)
        {
            item.IsSelected = isChecked;
        }
    }

    private async Task ConfirmReceiptItemsAsync()
    {
        if (receiptPreviewItems.Count == 0) return;

        var itemsToAdd = receiptPreviewItems
            .Where(i => i.IsSelected)
            .ToList();

        foreach (var item in itemsToAdd)
        {
            if (!item.IsMatched)
            {
                // This item was not matched, user needs to provide barcode manually
                // In a real app, we might show a modal here or let them type it in the UI
                // For now, we just skip it or notify the user
            }
            else
            {
                // Item was matched, we can proceed to add it
                // We'll need to call a service to add it to the pantry
            }
        }

        await OnReceiptItemsAdded.InvokeAsync();
    }

    private async Task OnBarcodeChanged(ChangeEventArgs e, ReceiptPreviewItem item)
    {
        var newBarcode = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(newBarcode))
        {
            item.Item.Barcode = newBarcode;
            try {
                var product = await productApiService.GetProductByBarcodeAsync(newBarcode);
                if (product is not null) {
                    var response = await Http.PostAsJsonAsync("api/productmatching/mapping", new ProductMappingDto { ProductName = item.Item.ProductName, Barcode = newBarcode, ProductId = product.Id });

                    if (response.IsSuccessStatusCode)
                    {
                        item.IsMatched = true;
                        item.MatchedBarcode = newBarcode;
                        item.MatchedProductName = product.ProductName;
                    }
                }
            }
            catch (Exception ex)
            {
                error = $"Error fetching product by barcode: {ex.Message}";
            }
        }
    }
}
