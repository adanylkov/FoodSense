@using BlazorBarcodeScanner.ZXing.JS
@using FoodSense.BlazorFrontend.Core
@using FoodSense.BlazorFrontend.Services
@using FoodSense.Common.Models
@inject ReceiptUploaderViewModel VM

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div>
                <h2 class="h5 fw-bold text-dark mb-1">Upload receipt JSON</h2>
                <p class="text-secondary small mb-0">Parse a receipt and review items before adding them to your pantry.</p>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 align-items-center">
            <InputFile OnChange="HandleReceiptFileSelected" accept=".json,application/json" class="form-control w-auto" />
        </div>

        @if (isLoadingReceipt)
        {
            <div class="d-flex align-items-center gap-2 mt-3 text-secondary">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Parsing receipt...</span>
            </div>
        }

        @if (receiptPreviewItems.Count > 0)
        {
            <div class="mt-4 border rounded-4 overflow-hidden">
                <div class="d-flex justify-content-between align-items-center gap-3 px-3 py-2 bg-body-tertiary border-bottom">
                    <div class="fw-semibold text-dark">Receipt preview</div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked="@AllReceiptItemsSelected" @onchange="ToggleSelectAllReceiptItems" />
                        <label class="form-check-label small text-secondary">Select all</label>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 48px;"></th>
                                <th>Name</th>
                                <th>Barcode</th>
                                <th>Match</th>
                                <th style="width: 48px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in receiptPreviewItems)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" checked="@(item.IsSelected && item.HasCandidate)" disabled="@(item.HasCandidate is false)" @onchange="(e => ToggleReceiptItemSelection(item, (bool?)e.Value ?? false))" />
                                    </td>
                                    <td>
                                        @{
                                            var className = item switch {
                                                
                                                { IsMatched: true, HasCandidate: true } => null,
                                                { IsMatched: false, HasCandidate: true } => "text-warning",
                                                _ => "text-muted"
                                            };
                                            <p class=@className>@item.Name</p>
                                        }
                                    </td>
                                    @if (item is {IsMatched: true, BarcodeCandidate: not null})
                                    {
                                        <td>@item.BarcodeCandidate</td>
                                    }
                                    else
                                    {
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="text" inputmode="numeric" class="form-control" placeholder="Enter barcode"
                                                       value="@item.BarcodeCandidate"
                                                       @onchange="(e) => OnBarcodeChanged(e, item)" />
                                                <button type="button"
                                                        class="btn btn-outline-secondary"
                                                        title="Scan barcode with camera"
                                                        aria-label="Scan barcode with camera"
                                                        @onclick="() => OpenBarcodeScanner(item)">
                                                    <span aria-hidden="true">&#128247;</span>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                    <td>
                                        @if (!item.IsMatched && item.HasCandidate) {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => RunWithErrorHandling(() => VM.AddProductMappingAsync(item))">Confirm Match</button>
                                            <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => { item.BarcodeCandidate = null; item.ProductName = null; }">Unmatch</button>
                                        }
                                        else if (item.IsMatched) {
                                            <span class="badge bg-success">Matched</span>
                                        }
                                        else {
                                            <span class="text-muted">No match</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-light btn-sm rounded-circle shadow-sm text-danger" title="Delete receipt item" aria-label="Delete @item.Name" @onclick="() => DeleteReceiptItem(item)">
                                            🗑️
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top bg-white">
                    <button class="btn btn-primary rounded-3 fw-semibold" type="button" @onclick="HandleSubmitAsync" disabled="@isAddingReceiptItems">
                        @if (isAddingReceiptItems)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            <span>Adding...</span>
                        }
                        else
                        {
                            <span>Confirm &amp; Add to Pantry</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <strong class="text-danger">Error:</strong> @error
        </div>
        <button type="button" class="btn-close" @onclick="() => error = null" aria-label="Close"></button>
    </div>
}

<BarcodeScanner IsOpen="isBarcodeScannerOpen"
                Subtitle="@(barcodeScannerItem?.Name)"
                OnClose="CloseBarcodeScanner"
                OnBarcodeDetected="HandleBarcodeReceivedAsync" />

@code {
    [Parameter] public EventCallback OnReceiptItemsAdded { get; set; }

    private bool isLoadingReceipt;
    private bool isAddingReceiptItems;
    private string? error;
    private List<ReceiptPreviewItem> receiptPreviewItems = [];
    private bool isBarcodeScannerOpen;
    private ReceiptPreviewItem? barcodeScannerItem;


    private bool AllReceiptItemsSelected => receiptPreviewItems.Count > 0 && receiptPreviewItems.All(item => item.IsSelected);

    private async Task HandleSubmitAsync()
    {
        isAddingReceiptItems = true;
        error = null;

        try
        {
            var result = await VM.ConfirmReceiptItemsAsync(receiptPreviewItems);
            if (result.IsSuccess)
            {
                receiptPreviewItems.Clear();
                await OnReceiptItemsAdded.InvokeAsync();
            }
            else
            {
                error = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            error = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isAddingReceiptItems = false;
        }
    }

    private async Task HandleReceiptFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null) return;

        if (!file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            error = "Only .json receipt files are supported.";
            receiptPreviewItems.Clear();
            return;
        }

        isLoadingReceipt = true;
        error = null;

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);

            receiptPreviewItems = await VM.ReadReceiptItems(stream, file.Name);

            if (receiptPreviewItems.Count > 0)
            {
                await RunWithErrorHandling(() => VM.MatchProductsAsync(receiptPreviewItems));
            }

            if (receiptPreviewItems.Count == 0)
            {
                error = "No receipt items could be parsed from this file.";
            }
        }
        catch (Exception ex)
        {
            error = $"Unable to parse the receipt file: {ex.Message}";
            receiptPreviewItems.Clear();
        }
        finally
        {
            isLoadingReceipt = false;
        }
    }
    private void ToggleReceiptItemSelection(ReceiptPreviewItem item, bool isSelected)
    {
        if (item.HasCandidate)
        {
            item.IsSelected = isSelected;
        }
    }

    private void ToggleSelectAllReceiptItems(ChangeEventArgs args)
    {
        var isChecked = args.Value as bool? ?? false;
        foreach (var item in receiptPreviewItems)
        {
            item.IsSelected = item.HasCandidate ? isChecked : item.IsSelected;
        }
    }

    private void DeleteReceiptItem(ReceiptPreviewItem item)
    {
        receiptPreviewItems.Remove(item);
    }


    private async Task RunWithErrorHandling(Func<Task<Result>> action)
    {
        try
        {
            var result = await action();
            if (!result.IsSuccess)
            {
                error = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            error = $"An unexpected error occurred: {ex.Message}";
        }
    }


    private void OpenBarcodeScanner(ReceiptPreviewItem item)
    {
        barcodeScannerItem = item;
        isBarcodeScannerOpen = true;
    }

    private void CloseBarcodeScanner()
    {
        isBarcodeScannerOpen = false;
        barcodeScannerItem = null;
    }

    private async Task HandleBarcodeReceivedAsync(BarcodeReceivedEventArgs args)
    {
        if (barcodeScannerItem is null || string.IsNullOrWhiteSpace(args.BarcodeText))
        {
            return;
        }

        var item = barcodeScannerItem;
        CloseBarcodeScanner();

        await RunWithErrorHandling(() => VM.SetBarcodeAsync(args.BarcodeText, item));
    }

    private async Task OnBarcodeChanged(ChangeEventArgs e, ReceiptPreviewItem item)
    {
        var newBarcode = e.Value?.ToString();
        await RunWithErrorHandling(() => VM.SetBarcodeAsync(newBarcode, item));
    }


}
